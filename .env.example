# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env real a git (ya está en .gitignore).
# Los comentarios van siempre en su propia línea.

# development en tu computador, production en el servidor
FLASK_ENV=development

# En producción es obligatoria y debe tener 32 caracteres o más.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente

# Vacía o comentada usa SQLite local (instance/indecap_dev.db).
# Con PostgreSQL (el controlador ya viene en requirements.txt):
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/indecap_aprende

# Correo para la recuperación de contraseña. Sin estos datos, en desarrollo
# el enlace se muestra en pantalla.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=

# Correo donde se atienden las solicitudes sobre datos personales.
# DATA_CONTACT_EMAIL=indecap@indecap.edu.co

# Servidores intermedios (nginx) delante de la aplicación. 0 en tu computador.
# TRUSTED_PROXIES=0

# Copias de seguridad (flask respaldo).
# BACKUP_DIR=instance/respaldos
# BACKUP_KEEP=14

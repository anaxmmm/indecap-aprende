# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env real a git (ya está en .gitignore).

FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente

# Déjala vacía/comentada para usar SQLite local automáticamente.
# En local con PostgreSQL instalado:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/indecap_aprende
# En Railway/Render, esta variable normalmente se genera automáticamente.
# DATABASE_URL=
